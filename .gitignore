__pycache__/

# Emacs projectile marker — personal editor state, not project content
/.projectile

# cloned HF Space, keeps its own .git + ~1.5G of LFS model weights
/VITS-Umamusume-voice-synthesizer/

# voice audition clips + ratings (local data)
/voice_audition/

# tools/bench_tts.py's running log (local data)
/bench_tts_log.csv

# Benchmark outputs contain request/response text and are machine-specific.
/benchmarks/results/

# M5StickS3 firmware: PlatformIO build artifacts + real WiFi/host creds
/firmware/*/.pio/
/firmware/*/include/secrets.h

# enrollment audio + voiceprint: personal biometric data, stays local
/memory/voiceprint_samples/
/memory/voiceprint.json

# stray nohup log from launching the bridge by hand
/nohup.out

# Android companion app: Gradle/Kotlin build output + machine-specific SDK path
/android_companion/.gradle/
/android_companion/.kotlin/
/android_companion/app/build/
/android_companion/local.properties
