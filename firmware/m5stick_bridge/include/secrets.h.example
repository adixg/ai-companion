// Copy to secrets.h (gitignored) and fill in.
#pragma once

#define WIFI_SSID   "your-phone-hotspot-name"
#define WIFI_PASS   "your-phone-hotspot-password"

// The Stick connects to the Termux relay (tools/termux_relay.py) on the
// phone — always reachable at WiFi.gatewayIP() since the phone is this
// Wi-Fi's own AP, so there's no IP to configure here (see main.cpp's
// connectNetwork()). Which laptop the relay actually talks to is chosen on
// the phone with --laptop-host, not here — see tools/termux_relay_setup.md.
#define WS_PORT     8765
#define WS_PATH     "/"
