// Copy to secrets.h (gitignored) and fill in.
#pragma once

// Must match the shared secret entered in the Android app's settings
// (android_companion/.../MainActivity.kt's secret field, persisted via
// Prefs.kt -- defaults to this exact placeholder on a fresh install, so a
// freshly-flashed Stick and a freshly-installed app interoperate out of
// the box). Change both sides together; see ble_transport.h's header
// comment for the full security model (bonding + this secret, two
// independent gates).
#define BLE_SHARED_SECRET   "spike-shared-secret-change-me"
