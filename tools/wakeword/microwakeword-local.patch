 from microwakeword.audio.audio_utils import remove_silence_webrtc
 
 
+class _LazyClips:
+    """A list of wav paths that loads each clip as {"audio": {"array"}} at 16 kHz."""
+
+    def __init__(self, paths):
+        self.paths = list(paths)
+
+    def __len__(self):
+        return len(self.paths)
+
+    def __getitem__(self, index):
+        import soundfile as sf
+        from math import gcd
+        from scipy.signal import resample_poly
+
+        data, rate = sf.read(self.paths[index], dtype="float32")
+        if data.ndim > 1:
+            data = data.mean(axis=1)
+        if rate != 16000:
+            g = gcd(rate, 16000)
+            data = resample_poly(data, 16000 // g, rate // g).astype(np.float32)
+        return {"audio": {"array": data, "sampling_rate": 16000, "path": self.paths[index]}}
+
+    def __iter__(self):
+        for i in range(len(self.paths)):
+            yield self[i]
+
